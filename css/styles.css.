@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--ink:#14233b;--muted:#617089;--navy:#0c1c34;--blue:#2463eb;--cyan:#5ce1e6;--pale:#f3f6fb;--line:#e2e8f0;--white:#fff;--radius:20px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{font-family:'DM Sans',sans-serif;color:var(--ink);line-height:1.65;background:#fff;padding-top:76px}h1,h2,h3,h4,.navbar-brand{font-family:'Manrope',sans-serif;font-weight:750;letter-spacing:-.035em}h1{font-size:clamp(2.7rem,6vw,5.2rem);line-height:1.05}h2{font-size:clamp(1.9rem,4vw,3rem);line-height:1.15}h3{font-size:1.25rem;letter-spacing:-.02em}p{color:var(--muted)}a{color:var(--blue)}a:hover{color:#1748b5}.skip-link{position:absolute;left:-9999px;top:8px;z-index:2000;background:#fff;padding:10px}.skip-link:focus{left:10px}.site-nav{background:rgba(12,28,52,.97);box-shadow:0 8px 24px #06152b20;min-height:76px}.navbar-brand{font-size:1.08rem;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--cyan);color:var(--navy);font-weight:900}.navbar-nav{gap:5px}.nav-link{color:#c5d0e0!important;font-size:.92rem;padding:.65rem .8rem!important;border-radius:9px}.nav-link:hover,.nav-link:focus,.nav-link.active{color:#fff!important;background:#ffffff13}.nav-cta{background:var(--blue);color:#fff!important}.nav-cta:hover{background:#3975ff!important}.hero{background:radial-gradient(ellipse at 75% 35%,#193d70 0,transparent 40%),var(--navy);color:#fff;padding:90px 0 76px;overflow:hidden}.hero h1{color:#fff}.hero h1 span{color:var(--cyan)}.eyebrow{font-size:.75rem;letter-spacing:.16em;font-weight:700;color:var(--blue);margin-bottom:1rem}.hero .eyebrow{color:var(--cyan)}.hero-lead{font-size:1.15rem;color:#c2cfe0;max-width:590px;margin:1.5rem 0 2rem}.btn{border-radius:11px;font-weight:650;padding:.78rem 1.2rem}.btn-primary{background:var(--blue);border-color:var(--blue)}.btn-primary:hover,.btn-primary:focus{background:#1748b5;border-color:#1748b5}.btn-outline-light:hover{color:var(--navy)}.hero-stats{display:flex;gap:2.2rem;margin-top:3rem}.hero-stats div{display:flex;flex-direction:column}.hero-stats strong{font-family:Manrope;font-size:1.7rem;color:#fff}.hero-stats span{font-size:.83rem;color:#aabbd2}.muted-note{color:#8294ad}.hero-visual{height:420px;position:relative;display:grid;place-items:center}.blueprint{width:min(360px,90%);height:350px;border:1px solid #5ce1e65c;border-radius:24px;background:linear-gradient(135deg,#17365b,#102541);position:relative;box-shadow:0 30px 70px #0003;transform:rotate(-5deg);padding:24px;overflow:hidden}.blueprint:before{content:'';position:absolute;inset:0;background-image:linear-gradient(#7da6d51a 1px,transparent 1px),linear-gradient(90deg,#7da6d51a 1px,transparent 1px);background-size:24px 24px}.bp-label,.bp-coordinate{position:relative;color:#8eb4d8;font-size:.7rem;letter-spacing:.12em}.bp-coordinate{position:absolute;bottom:24px;right:20px}.bp-shape{position:absolute;width:180px;height:180px;border:2px solid var(--cyan);left:calc(50% - 90px);top:calc(50% - 90px);transform:rotate(45deg);border-radius:15px;box-shadow:0 0 35px #5ce1e620}.bp-shape:after{content:'';position:absolute;inset:28px;border:1px dashed #8eb4d8;border-radius:8px}.orbit{position:absolute;border:1px solid #5ce1e62b;border-radius:50%;width:390px;height:390px}.orbit-two{width:460px;height:460px;border-color:#8ab5ff20}.floating-chip{position:absolute;background:#fff;color:var(--navy);font-size:.68rem;font-weight:800;letter-spacing:.08em;padding:12px 16px;border-radius:10px;box-shadow:0 15px 35px #0003}.chip-top{top:38px;right:0}.chip-bottom{bottom:32px;left:0}.section{padding:80px 0}.section-white{background:#fff}.section-tint{background:var(--pale)}.section-heading{max-width:680px;margin-bottom:2.5rem}.section-heading h2{margin-bottom:1rem}.feature-card{height:100%;border:1px solid var(--line);border-radius:var(--radius);padding:28px;background:#fff;transition:transform .2s,box-shadow .2s}.feature-card:hover{transform:translateY(-4px);box-shadow:0 16px 35px #152c4a0c}.feature-icon{font-weight:800;color:var(--blue);font-size:.8rem;background:#edf3ff;border-radius:9px;padding:10px 12px;display:inline-block;margin-bottom:1.4rem}.feature-card h3{margin-bottom:.8rem}.page-hero{padding:65px 0 55px;background:var(--pale);border-bottom:1px solid var(--line)}.page-hero h1{font-size:clamp(2.4rem,5vw,4rem);margin-bottom:1rem}.page-lead{max-width:700px;font-size:1.1rem;margin:0}.program-card{height:100%;border:1px solid var(--line);border-radius:var(--radius);padding:25px;background:white;transition:.2s}.program-card:hover{border-color:#a9c2ff;box-shadow:0 15px 35px #183d7710;transform:translateY(-3px)}.program-number{font-size:.7rem;color:#8290a5;font-weight:800;letter-spacing:.1em}.program-symbol{display:grid;place-items:center;width:58px;height:58px;background:#edf3ff;color:var(--blue);font-size:1.8rem;border-radius:16px;margin:1.4rem 0}.program-card h3{min-height:3rem}.program-card a{font-weight:700;text-decoration:none}.btn-filter{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:30px;padding:.55rem 1rem}.btn-filter.active,.btn-filter:hover{background:var(--navy);color:white;border-color:var(--navy)}.admission-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.admission-steps article{display:flex;gap:20px;padding:25px;border:1px solid var(--line);border-radius:16px}.admission-steps article>span{color:var(--blue);font-weight:800;font-size:1.1rem}.admission-steps h3{margin-bottom:.5rem}.admission-steps p{margin:0}.tuition-table{border-color:var(--line)}.tuition-table thead th{background:var(--navy);color:#fff;padding:15px}.tuition-table td{padding:14px}.notice-card{padding:18px 20px;background:#edf3ff;border-left:4px solid var(--blue);border-radius:12px;color:var(--ink)}.notice-card p{margin-top:.5rem}.life-card{height:100%;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.life-art{height:180px;display:grid;place-items:center;font-size:5rem;font-weight:700}.art-blue{background:#e8efff;color:#2463eb}.art-orange{background:#fff0df;color:#d97706}.art-green{background:#e5f7ed;color:#16834b}.life-content{padding:24px}.tag{font-size:.7rem;letter-spacing:.1em;font-weight:800;color:var(--blue)}.life-content h3{margin:.7rem 0}.news-list{border-top:1px solid var(--line)}.news-list article{display:grid;grid-template-columns:160px 1fr auto;gap:24px;padding:24px 0;border-bottom:1px solid var(--line);align-items:start}.news-list time{color:var(--blue);font-size:.88rem;font-weight:700}.news-list h3{margin-bottom:.5rem}.news-list p{margin:0}.news-label{font-size:.7rem;font-weight:800;letter-spacing:.1em;color:#8491a4}.contact-detail{display:flex;gap:15px;margin:25px 0}.contact-icon{width:44px;height:44px;display:grid;place-items:center;background:#edf3ff;color:var(--blue);border-radius:12px;font-size:1.2rem}.contact-detail p{margin:.25rem 0}.form-panel{background:#fff;border:1px solid var(--line);border-radius:22px;padding:clamp(22px,4vw,38px);box-shadow:0 20px 55px #183d7708}.form-label,legend{font-weight:700;color:var(--ink);font-size:.92rem}.form-control,.form-select{border-color:#d8e0ec;border-radius:10px;min-height:47px;color:var(--ink)}textarea.form-control{min-height:unset}.form-control:focus,.form-select:focus,.form-check-input:focus{border-color:#6b95ff;box-shadow:0 0 0 .22rem #2463eb20}.form-check-input{border-color:#b9c6d8}.form-check-input:checked{background-color:var(--blue);border-color:var(--blue)}.form-topline{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.4rem}.form-status{font-weight:650}.form-status.success{color:#137a43;background:#e8f7ef;padding:12px 14px;border-radius:10px}.form-status.error{color:#b42318}.mini-steps p{display:flex;align-items:center;gap:12px;color:var(--ink);font-weight:650}.mini-steps span{display:grid;place-items:center;width:30px;height:30px;background:#edf3ff;color:var(--blue);border-radius:50%;font-size:.75rem}.site-footer{background:var(--navy);padding:25px 0;color:#9eafc7;font-size:.85rem}.site-footer a{color:#c9d8ec;text-decoration:none}.site-footer a:hover{text-decoration:underline}
@media(max-width:991.98px){.navbar-nav{padding:12px 0}.nav-link{padding:.6rem .8rem!important}.hero{padding:65px 0}.hero-visual{height:360px}.hero-stats{gap:1.5rem}.hero-stats strong{font-size:1.4rem}}
@media(max-width:767.98px){body{padding-top:70px}.site-nav{min-height:70px}.hero{padding:55px 0}.hero-visual{height:330px;margin-top:10px}.blueprint{height:300px}.orbit{width:300px;height:300px}.orbit-two{width:350px;height:350px}.hero-stats{gap:1rem;flex-wrap:wrap}.hero-stats strong{font-size:1.3rem}.hero-stats span{font-size:.72rem}.section{padding:60px 0}.page-hero{padding:48px 0 40px}.admission-steps{grid-template-columns:1fr}.news-list article{grid-template-columns:1fr;gap:8px}.news-label{display:none}.form-panel{padding:22px}.form-topline{align-items:flex-start;gap:10px;flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important;animation:none!important}}
